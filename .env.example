# Environment configuration for Autonomous Data Analyst

# OpenAI API Key (Required for live agent model calls)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Identifier (Optional: defaults to openai/gpt-4o)
# Supported models: openai/gpt-4o, openai/gpt-4o-mini, openai/o1, openai/o3-mini
MODEL_NAME=openai/gpt-4o

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Multi-Tenant & Server Configuration
PORT=3001
MULTI_TENANT_MODE=true

# PostgreSQL Persistence
# Leave blank to use in-memory SQLite/mock adapter for development/tests
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_data_analyst

# BullMQ Background Job Queue (Redis)
# Leave blank to use in-memory durable queue fallback
REDIS_URL=redis://localhost:6379

# Dataset Directory & Upload Limits
DATASETS_DIR=./datasets
MAX_DATASET_SIZE_MB=50

# Python Sandbox Execution Isolation
# Options: 'restricted_subprocess' (dev workstation), 'strict_container_only' (production)
PYTHON_SANDBOX_MODE=restricted_subprocess

# Container Sandbox Active Indicator
# Must be paired with a verifiable kernel-isolated container runtime (e.g., /.dockerenv, cgroups)
CONTAINER_SANDBOX_ACTIVE=false

# Milestone 12: Encryption & Security Key
# 32-byte hex string or secure passphrase for AES-256-GCM delivery destination & BI secret encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Milestone 12: Background Scheduler Configuration
SCHEDULER_POLL_INTERVAL_MS=30000

# Milestone 12: External BI Platform Credentials (Optional for live testing)
# Apache Superset API Endpoint & Credentials
SUPERSET_URL=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
